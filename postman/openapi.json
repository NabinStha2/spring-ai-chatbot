{"openapi":"3.1.0","info":{"title":"Spring AI Chatbot API","description":"Local chat API powered by Spring AI and Ollama.","version":"v1"},"servers":[{"url":"http://localhost:8080"}],"paths":{"/api/v1/chat":{"post":{"tags":["chat"],"operationId":"chat","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatRequest"}}},"required":true},"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatResponse"}}}}}}},"/api/v1/chat/stream":{"get":{"tags":["chat"],"operationId":"chatStream","parameters":[{"name":"conversationId","in":"query","required":true,"schema":{"type":"string"}},{"name":"message","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"text/event-stream":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/ServerSentEventChatStreamEventResponse"}}}}}}}}},"components":{"schemas":{"ChatRequest":{"type":"object","properties":{"conversationId":{"type":"string","description":"Identifier for the conversation","example":"chat-001","minLength":1},"message":{"type":"string","description":"The user's message","example":"Hello! Please introduce yourself.","maxLength":2000,"minLength":0}},"required":["conversationId","message"]},"ChatResponse":{"type":"object","description":"The assistant's reply","properties":{"response":{"type":"string","description":"Generated assistant response","example":"Hello! I'm an AI assistant. How can I help?"}}},"ServerSentEventChatStreamEventResponse":{}}}}